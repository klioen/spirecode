{
  "name": "spirecode",
  "private": true,
  "version": "0.1.0",
  "description": "Fast Lightweight GUI Code Agent",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "node scripts/electron-dev.mjs",
    "prepare:pi-extensions": "node scripts/prepare-pi-extensions.mjs",
    "check:pi-extensions": "node scripts/check-pi-extensions.mjs",
    "dev:renderer": "vite",
    "dev:main": "tsup --watch",
    "dev:electron": "wait-on tcp:1420 dist-electron/main.js && electron .",
    "build": "pnpm typecheck && pnpm build:renderer && pnpm build:main",
    "build:renderer": "vite build",
    "build:main": "tsup",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:check": "node scripts/check-brand.mjs",
    "i18n:check": "node scripts/check-localized-copy.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm brand:check && pnpm i18n:check && pnpm lint && pnpm typecheck && pnpm test",
    "smoke:app": "./scripts/smoke-app.sh",
    "smoke:dmg": "./scripts/smoke-dmg.sh",
    "bundle": "node scripts/package-electron.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@remixicon/react": "4.9.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "4.0.3",
    "clsx": "2.1.1",
    "ignore": "7.0.5",
    "monaco-editor": "0.56.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "pi-extensions": "github:klioen/pi-extensions#e5937af0cd7d2f22907e6a31a2aa338c96316771",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.bytedance.spirecode.dev",
    "productName": "SpireCode",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.test.*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": ".build/pi-extensions",
        "to": "pi-extensions",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ]
  }
}
