{
  "name": "spirecode",
  "private": true,
  "version": "0.1.0",
  "description": "Fast Lightweight GUI Code Agent",
  "author": {
    "name": "SpireCode Maintainers",
    "email": "klioen@users.noreply.github.com"
  },
  "homepage": "https://github.com/klioen/spirecode",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/klioen/spirecode.git"
  },
  "bugs": {
    "url": "https://github.com/klioen/spirecode/issues"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "node scripts/electron-dev.mjs",
    "dev:renderer": "vite",
    "dev:main": "tsup --watch",
    "dev:electron": "wait-on tcp:1420 dist-electron/main.js && electron .",
    "build": "pnpm typecheck && pnpm build:renderer && pnpm build:main",
    "build:renderer": "vite build",
    "build:main": "tsup",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:check": "node scripts/check-brand.mjs",
    "i18n:check": "node scripts/check-localized-copy.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm brand:check && pnpm i18n:check && pnpm secrets:check && pnpm licenses:check && pnpm lint && pnpm typecheck && pnpm test && pnpm release:test",
    "smoke:app": "./scripts/smoke-app.sh",
    "smoke:dmg": "./scripts/smoke-dmg.sh",
    "bundle": "node scripts/package-electron.mjs",
    "release:test": "node --test scripts/release/*.test.mjs",
    "release:build": "node scripts/release/build.mjs",
    "release:metadata": "node scripts/release/checksums.mjs && node scripts/release/sbom.mjs",
    "legal:prepare": "node scripts/prepare-legal-resources.mjs",
    "licenses:check": "node scripts/check-production-licenses.mjs",
    "secrets:check": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@mariozechner/clipboard": "0.3.9",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@remixicon/react": "4.9.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "5.0.0",
    "clsx": "2.1.1",
    "ignore": "7.0.9",
    "monaco-editor": "0.56.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.7",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "io.github.klioen.spirecode",
    "productName": "SpireCode",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/@mariozechner/clipboard*/**/*"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.test.*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": ".build/legal",
        "to": "legal",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "assets/icons",
      "category": "Development",
      "maintainer": "SpireCode Maintainers <klioen@users.noreply.github.com>",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "dompurify": "3.4.15"
    }
  },
  "optionalDependencies": {
    "@mariozechner/clipboard-darwin-arm64": "0.3.9",
    "@mariozechner/clipboard-linux-x64-gnu": "0.3.9",
    "@mariozechner/clipboard-win32-x64-msvc": "0.3.9"
  }
}
